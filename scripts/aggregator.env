# Miru-Log aggregator PC sample config
# Copy this to .env on the aggregation PC, then adjust the values.
#
# The aggregation PC reads all per-PC folders under ANALYZER_DATA_ROOT,
# runs analysis, builds the daily report, and optionally sends notifications.

# --- Shared storage root ---
# Parent folder that contains per-PC folders such as:
#   \\server\share\mirulog\DESKTOP-ABC123\mirulog.db
#   \\server\share\mirulog\LAPTOP-XYZ789\mirulog.db
ANALYZER_DATA_ROOT=C:/Users/nakamura/Dropbox/アプリ/Miru-Log


# --- Analyzer backend ---
ANALYZER_BACKEND=local

# Gemini settings (required when ANALYZER_BACKEND=gemini)
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-pro-vision
GEMINI_MAX_TOKENS=1024
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_RETRIES=5
GEMINI_RETRY_BUFFER_SECONDS=0.5
GEMINI_REQUEST_SPACING_SECONDS=0

# Local LLM settings (used when ANALYZER_BACKEND=local)
LOCAL_LLM_BASE_URL=http://100.87.177.110:11434/v1
LOCAL_LLM_MODEL=gemma4-long:latest
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TEMPERATURE=0.4
LOCAL_LLM_TIMEOUT_SECONDS=60

# Output and logs on the aggregation PC
SUMMARY_OUTPUT_DIR=output
REPORT_EXPORT_DIR=C:\Users\nakamura\Dropbox\アプリ\remotely-save\vault\00_Inbox\MiruLog
LOG_DIR=logs
LOG_LEVEL=INFO

# Cleanup retention used by pipeline.py
DATA_RETENTION_DAYS=7

# Optional visualization
ENABLE_VISUALIZATION=false
# NANOBANANA_API_KEY=
# NANOBANANA_ENDPOINT=https://api.nanobanana.pro/v1/images
# NANOBANANA_MODEL=nano-pro-vision

# Optional Google Calendar export for notifier.py
# credentials.json must exist in the repo root when using notifier.
# GOOGLE_CALENDAR_ID=primary

TIMEZONE=Asia/Tokyo
